{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchAsset",
  "type": "object",
  "required": [
    "asset_id",
    "title",
    "type",
    "source",
    "maturity",
    "claim",
    "evidence",
    "reuse_targets"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^RA-[A-Z0-9_-]+$"
    },
    "title": {"type": "string"},
    "type": {
      "enum": [
        "theorem",
        "conjecture",
        "algorithm",
        "implementation",
        "dataset",
        "benchmark",
        "oracle",
        "negative_result",
        "architecture",
        "literature_map",
        "upstream_contribution"
      ]
    },
    "source": {
      "type": "object",
      "required": ["repository", "visibility"],
      "properties": {
        "repository": {"type": "string"},
        "path": {"type": ["string", "null"]},
        "commit": {"type": ["string", "null"]},
        "visibility": {"enum": ["public"]},
        "url": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "maturity": {
      "enum": ["L0_IDEA", "L1_PROTOTYPE", "L2_VERIFIED", "L3_RESEARCH", "L4_PUBLISHED_OR_UPSTREAM"]
    },
    "claim": {"type": "string"},
    "scope": {"type": ["string", "null"]},
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "reference"],
        "properties": {
          "kind": {"type": "string"},
          "reference": {"type": "string"}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string"}
    },
    "reuse_targets": {
      "type": "array",
      "items": {"type": "string"}
    },
    "negative_of": {
      "type": ["string", "null"]
    },
    "status": {
      "enum": ["active", "archive", "maintain", "research", "upstream"]
    },
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
